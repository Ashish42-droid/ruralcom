{
  "name": "ruralai",
  "version": "0.1.0",
  "private": true,
  "description": "RuralAI — AI-assisted virtual rural health clinic platform (Core API)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "oxlint .",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/migrate.js",
    "llm:check": "node --env-file=.env scripts/llm-smoke.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "oxlint": "^1.75.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4"
  }
}
