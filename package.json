{
  "name": "ruralai",
  "version": "0.1.0",
  "private": true,
  "description": "RuralAI Core API — AI-assisted virtual rural health clinic platform",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env server.js",
    "start": "node server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "oxlint .",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/migrate.js",
    "llm:check": "node --env-file=.env scripts/llm-smoke.js",
    "livekit:check": "node --env-file=.env scripts/livekit-smoke.js",
    "assessment:check": "node --env-file=.env scripts/assessment-smoke.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "demo": "npm run web:build && npm start"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.58.0",
    "bullmq": "^6.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "^2.18.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.3",
    "oxlint": "^1.75.0",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.4"
  }
}
