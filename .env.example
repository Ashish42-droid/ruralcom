# RuralAI — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored. This file is committed and must contain NO real secrets.

# ============================================================
# Supabase — database, auth, storage, realtime
# ============================================================
# Project URL, from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# PUBLIC key. Safe in the browser — every request it makes is subject to RLS.
SUPABASE_ANON_KEY=your-anon-key

# SECRET key. SERVER ONLY. Bypasses all row-level security, so it must never
# reach the browser, a NEXT_PUBLIC_* variable, a log line, or a commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, for migrations and Drizzle.
# Dashboard → Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Frontend-exposed copies. Only ever the URL and the anon key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# AI — assessment layer
# ============================================================
# Groq — hosted provider, chosen 2026-08-24 (D-035). OpenAI-compatible chat
# completions API, so services/llm/adapters.js talks to it directly with no
# SDK dependency. Get a key at console.groq.com/keys. Without this, the
# triage engine has no model and floors every case at MEDIUM — the safe
# default — so the app runs fine with this unset, just less usefully.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_ID=openai/gpt-oss-120b

# Self-hosted DeepSeek R1 — post-incubation target (docs/DECISIONS.md D-030).
# Served behind vLLM or SGLang, which expose an OpenAI-compatible endpoint,
# so the same adapter serves any self-hosted open-weight model.
SELF_HOSTED_LLM_BASE_URL=http://your-pod:8000/v1
SELF_HOSTED_LLM_MODEL_ID=deepseek-r1
SELF_HOSTED_LLM_API_KEY=optional-if-your-pod-requires-one

# ============================================================
# Video consultation — LiveKit (docs/DECISIONS.md D-031)
# ============================================================
# Open source and self-hostable. LiveKit Cloud has a free tier for the demo;
# self-hosting is the post-incubation path. Server SDK signs join tokens, so
# the API secret must never reach the browser.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ============================================================
# Speech & translation (§E.1)
# ============================================================
# Demo languages: Hindi, Bengali, Tamil, English (Bhojpuri removed, D-026).
# Bhashini / ULCA — primary Indic STT, TTS and translation.
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-api-key
BHASHINI_PIPELINE_ID=your-bhashini-pipeline-id

# Google Cloud — fallback STT/TTS/translation, and Document AI for OCR.
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCUMENTAI_PROCESSOR_ID=your-processor-id

# ============================================================
# Infrastructure
# ============================================================
# Redis — BullMQ job queue (consultation tolerance windows) and, later, the
# Socket.IO multi-instance adapter.
#
# NOTE the scheme: Upstash requires TLS, so this must be rediss:// not
# redis://. The dashboard's redis-cli example passes --tls as a separate
# flag, but ioredis negotiates TLS from the scheme alone -- with plain
# redis:// the connection fails in a way that looks like a network fault.
# config/env.js rejects a redis:// upstash.io URL for exactly this reason.
#
# Optional: without it the API still serves every clinical route, but a
# missed consultation will NOT auto-reassign. Logged loudly at boot.
REDIS_URL=rediss://default:your-token@your-endpoint.upstash.io:6379

# REST endpoint. Not used by BullMQ (which speaks the Redis wire protocol);
# kept for any future HTTP-only caller, e.g. an edge function.
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io

# Error tracking.
SENTRY_DSN=your-sentry-dsn

# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Secret used to sign the RuralAI Health ID check payloads and internal tokens.
# Generate with: openssl rand -hex 32
APP_SECRET=generate-a-random-32-byte-hex-string

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
